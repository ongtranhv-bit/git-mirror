{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "typeRoots": ["./types"],
    "baseUrl": ".",
    "paths": {
      "undici-types": ["types/undici-types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".test-dist"]
}
