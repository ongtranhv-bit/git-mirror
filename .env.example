# Config source priority: CONFIG_JSON > CONFIG_FILE > RTDB config node.
CONFIG_FILE=/app/config/config.json
# CONFIG_JSON={"configVersion":6,...}

# Firebase Realtime Database.
RTDB_URL=https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
RTDB_CONFIG_PATH=/sync/config
# Preferred: base64 of the complete service-account JSON.
GOOGLE_SERVICE_ACCOUNT_B64=
# Compatibility fallback when a legacy database secret is available.
RTDB_AUTH_SECRET=

# Optional stable instance identifier. Leave empty for hostname-pid-random.
INSTANCE_ID=

# Codespace keep-alive: periodically opens a short gh codespace ssh connection to
# this codespace so the idle timer never elapses. Only runs when the process is
# inside a GitHub Codespace AND CODESPACE_NAME is set AND the gh CLI exists;
# otherwise the listener logs a warning and skips it (no error).
CODESPACE_KEEPALIVE_ENABLED=true
CODESPACE_KEEPALIVE_INTERVAL_MINUTES=10

# Webhook path in RTDB where GitHub webhook deliveries are stored.
# Override rtdb.webhookPath in config.json. Default: /github-noti
WEBHOOK_PATH=/github-noti

# Hot reload: khi config trên RTDB thay đổi, worker tự load config mới và áp
# dụng ngay (không restart). Tắt bằng CONFIG_AUTO_RELOAD=0. Mặc định bật khi
# config được load từ RTDB.
# CONFIG_AUTO_RELOAD=1

# Runner singleton (chỉ 1 instance hoạt động cho cùng owner/repo/workflow).
# - GitHub Actions / Azure Pipelines tự nhận diện qua env CI (GITHUB_WORKFLOW_REF
#   hoặc BUILD_REPOSITORY_URI + SYSTEM_PIPELINEID).
# - Docker/local không có CI: đặt RUNNER_KEY để tham gia dedup, key = manual:<value>.
# - RUNNER_REGISTRY_DISABLED=1 để bỏ qua hoàn toàn (chạy độc lập).
# - Azure không expose tên yml qua env: đặt RUNNER_WORKFLOW_FILE trong pipeline,
#   nếu không key sẽ dùng pipeline id.
# RUNNER_KEY=docker-prod-1
# RUNNER_REGISTRY_DISABLED=0
# RUNNER_WORKFLOW_FILE=azure-pipelines.yml

# RTDB node chứa runner lease records. Default /sync/runners (rtdb.runnerPath).
# RTDB_RUNNER_PATH=/sync/runners

# Source credentials selected from hook.provider.
SOURCE_GITHUB_PAT=
SOURCE_GITEA_PAT=
SOURCE_AZURE_PAT=

# Destination credentials; each destination has its own variable.
DEST_GITHUB_PAT=
DEST_GITEA_PAT=
DEST_AZURE_PAT=

# Codespace Rotation control-plane (rotation config is separate from AppConfig v6).
CODESPACE_ROTATION_CONFIG_PATH=/sync/codespace/config
CODESPACE_ROTATION_BASE_PATH=/sync/codespace
CODESPACE_READINESS_PATH=/sync/codespace/instances
CODESPACE_ROTATION_TIMEZONE=Asia/Ho_Chi_Minh
GH_CODESPACE_API_VERSION=2026-03-10
# Lifecycle credentials are named by rotation config, for example:
# GH_CODESPACE_TOKEN_DAY_07=
# Runtime source credentials are GitHub Codespaces secrets. Startup resolves
# the current day to GH_SOURCE_TOKEN_CURRENT and unsets GH_SOURCE_TOKEN_DAY_XX
# before starting Node. AppConfig v6 should reference ${GH_SOURCE_TOKEN_CURRENT}.
# GH_SOURCE_TOKEN_DAY_07=
# Scheduler alternative: one GitHub Actions secret containing a base64 JSON map
# whose keys are the lifecycle profile/env names used by rotation config.
# CODESPACE_LIFECYCLE_TOKENS_B64=<base64 of {"GH_CODESPACE_TOKEN_DAY_07":"..."}>
# CODESPACE_ROTATION_CONFIG_FILE=/app/codespace-rotation.json
# CODESPACE_ROTATION_CONFIG_JSON={"configVersion":1,...}
