{
  "name": "git-mirror-sync-service",
  "version": "0.1.0",
  "description": "RTDB-driven Git mirror service supporting one-to-one and many-to-one sync.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "git-mirror": "dist/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test.mjs",
    "cli": "node scripts/cli.mjs",
    "start": "node dist/cli.js run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run security:scan",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "keywords": [
    "git",
    "mirror",
    "firebase",
    "rtdb",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "file:vendor/typescript"
  }
}
