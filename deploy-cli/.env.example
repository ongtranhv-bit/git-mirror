GHCLI_TOKEN=github_pat_replace_me
GHCLI_REPO=owner/repository

# ghcli:repo-and-codespaces-secret
# This comment does not affect the annotation.
// The parser continues to the next assignment.
EXAMPLE_SHARED_SECRET=replace_me

# ghcli:repo-secret
EXAMPLE_ACTIONS_ONLY_SECRET=replace_me

# ghcli:codespaces-secret
EXAMPLE_CODESPACES_SECRET=replace_me

# ghcli:repo-variable
EXAMPLE_ACTIONS_VARIABLE=replace_me

# Azure DevOps (azurecli.mjs) — cần project, group id; token PAT với
# scope Variable Groups (Read & Manage).
AZURECLI_TOKEN=azure_devops_pat_replace_me
AZURECLI_ORG=organization
AZURECLI_PROJECT=project
AZURECLI_GROUP_ID=1
AZURECLI_GROUP_NAME=git-mirror

# azurecli:pipeline-secret
EXAMPLE_AZURE_SECRET=replace_me

# azurecli:pipeline-variable
EXAMPLE_AZURE_VARIABLE=replace_me